{% extends 'contabilidad/crud_base.html.twig' %}

{% block title %}{{ 'contabilidad.clientes.title'|trans }} — {{ 'contabilidad.title'|trans }}{% endblock %}

{% block breadcrumbs %}
    <ul>
        <li><a href="{{ path('app_contabilidad') }}">{{ 'contabilidad.panel.breadcrumb'|trans }}</a></li>
        <li><a href="{{ path('contabilidad_cliente_index') }}">{{ 'contabilidad.clientes.title'|trans }}</a></li>
        <li>{{ 'admin.articulos.list'|trans }}</li>
    </ul>
{% endblock %}

{% block crud_content %}
<main class="fondo-pagina">
    <div class="contenedor-principal">
        <section class="tarjeta-maestra">

            <header class="cabecera-tarjeta">
                <h1>{{ 'contabilidad.clientes.title'|trans }}</h1>
            </header>

            {% if clientes is empty %}
                <p class="tarjeta-vacia">{{ 'contabilidad.clientes.empty'|trans }}</p>
            {% else %}
                <div class="envoltorio-tabla">
                    <table>
                        <thead>
                            <tr>
                                <th>{{ 'comun.nombre'|trans }}</th>
                                <th>{{ 'comun.correo'|trans }}</th>
                                <th>{{ 'comun.telefono'|trans }}</th>
                                <th class="texto-centrado">{{ 'comun.acciones'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for c in clientes %}
                                <tr>
                                    <td class="texto-primario-negrita">{{ c.nombre }} {{ c.apellidos }}</td>
                                    <td>{{ c.email }}</td>
                                    <td>{{ c.telefono ?: '—' }}</td>
                                    <td class="texto-centrado">
                                        <a href="{{ path('contabilidad_cliente_pedidos', {id: c.id}) }}"
                                           class="boton-accion-contable boton-factura">
                                            <span class="material-icons">receipt_long</span>
                                            {{ 'contabilidad.ver_pedidos'|trans }}
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <footer class="pie-tarjeta">
                    <p>{{ 'admin.crud.total'|trans }}: <strong>{{ clientes|length }}</strong></p>
                </footer>
            {% endif %}

        </section>
    </div>
</main>
{% endblock %}
