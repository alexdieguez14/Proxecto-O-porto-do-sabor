{% extends ('contabilidad' in app.request.attributes.get('_route'))
    ? 'contabilidad/crud_base.html.twig'
    : 'admin/crud_base.html.twig' %}

{% set _ctx = 'contabilidad' in app.request.attributes.get('_route') %}

{% block title %}{{ 'admin.proveedores.breadcrumb'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/admin_articulos.css') }}">
{% endblock %}

{% block breadcrumbs %}
    <ul>
        {% if _ctx %}
            <li><a href="{{ path('app_contabilidad') }}">{{ 'contabilidad.panel.breadcrumb'|trans }}</a></li>
        {% else %}
            <li><a href="{{ path('app_admin') }}">{{ 'admin.master_data.home'|trans }}</a></li>
            <li><a href="{{ path('admin_datos_maestros') }}">{{ 'admin.master_data.breadcrumb'|trans }}</a></li>
        {% endif %}
        <li><a href="{{ path(_ctx ? 'contabilidad_proveedor_index' : 'admin_proveedor_index') }}">{{ 'admin.proveedores.breadcrumb'|trans }}</a></li>
        <li>{{ 'admin.proveedores.list'|trans }}</li>
    </ul>
{% endblock %}

{% block crud_content %}
<main class="fondo-pagina">
    <div class="contenedor-principal">
        <section class="tarjeta-maestra">

            <header class="cabecera-tarjeta">
                <h1>{{ 'admin.proveedores.title'|trans }}</h1>
                <a href="{{ path(_ctx ? 'contabilidad_proveedor_nuevo' : 'admin_proveedor_nuevo') }}" class="boton-nuevo">
                    <span class="material-icons" aria-hidden="true">add</span>
                    {{ 'admin.proveedores.new'|trans }}
                </a>
            </header>

            {% if proveedores is empty %}
                <p class="tarjeta-vacia">{{ 'admin.crud.no_results'|trans }}</p>
            {% else %}
                <div class="envoltorio-tabla">
                    <table>
                        <thead>
                            <tr>
                                <th>{{ 'comun.nombre'|trans }}</th>
                                <th>{{ 'comun.telefono'|trans }}</th>
                                <th>{{ 'comun.correo'|trans }}</th>
                                <th>{{ 'logistica.inventario.articles'|trans|capitalize }}</th>
                                <th class="texto-centrado">{{ 'comun.acciones'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for p in proveedores %}
                                <tr>
                                    <td class="texto-primario-negrita">{{ p.nombre }}</td>
                                    <td>{{ p.telefono ?: '—' }}</td>
                                    <td>{{ p.email ?: '—' }}</td>
                                    <td>
                                        <span class="contador-insignia">{{ p.articulos|length }}</span>
                                    </td>
                                    <td class="texto-centrado">
                                        <div class="acciones-fila">
                                            <a href="{{ path(_ctx ? 'contabilidad_proveedor_editar' : 'admin_proveedor_editar', {id: p.id}) }}"
                                               class="boton-accion boton-accion--editar"
                                               title="{{ 'comun.editar'|trans }}">
                                                <span class="material-icons">edit</span>
                                            </a>
                                            <form method="post"
                                                  action="{{ path(_ctx ? 'contabilidad_proveedor_eliminar' : 'admin_proveedor_eliminar', {id: p.id}) }}"
                                                  onsubmit="return confirm('{{ 'admin.crud.confirm_delete'|trans|escape('js') }}')">
                                                <input type="hidden" name="_token"
                                                       value="{{ csrf_token('delete_proveedor_' ~ p.id) }}">
                                                <button type="submit"
                                                        class="boton-accion boton-accion--eliminar"
                                                        title="{{ 'comun.eliminar'|trans }}">
                                                    <span class="material-icons">delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <footer class="pie-tarjeta">
                    <p>{{ 'admin.crud.total'|trans }}: <strong>{{ proveedores|length }}</strong></p>
                </footer>
            {% endif %}

        </section>
    </div>
</main>
{% endblock %}
